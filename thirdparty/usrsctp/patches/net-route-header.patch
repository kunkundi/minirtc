diff --git a/meson.build b/meson.build
index daac925bd..f42903d6b 100644
--- a/meson.build
+++ b/meson.build
@@ -114,6 +114,11 @@ if have_sys_types and have_netinet_in and have_netinet_ip and have_netinet_ip_ic
