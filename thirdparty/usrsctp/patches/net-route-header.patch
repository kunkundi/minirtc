diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e3319542..70be997d6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -110,6 +110,11 @@ if (have_netinet_ip_icmp_h)
