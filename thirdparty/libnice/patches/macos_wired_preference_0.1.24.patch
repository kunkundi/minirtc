diff --git a/agent/stream.c b/agent/stream.c
index c4fb8c3..df8afb9 100644
--- a/agent/stream.c
+++ b/agent/stream.c
@@ -41,8 +41,86 @@
 
 #include <string.h>
 
+#include <net/if.h>
+#include <SystemConfiguration/SystemConfiguration.h>
+
+#include "agent-priv.h"
+#include "interfaces.h"
 #include "stream.h"
 
+static gboolean
+is_wired_address (const NiceStream *stream, const NiceAddress *address)
+{
+  for (const GSList *i = stream->wired_addresses; i; i = i->next)
+    if (nice_address_equal_no_port (i->data, address))
+      return TRUE;
+  return FALSE;
+}
+
+static gint
+wired_first (gconstpointer a, gconstpointer b, gpointer stream)
+{
+  return is_wired_address (stream, b) - is_wired_address (stream, a);
+}
+
+GSList *
+nice_stream_prefer_wired_addresses (NiceStream *stream, GSList *addresses)
+{
+  CFArrayRef interfaces = SCNetworkInterfaceCopyAll ();
+  GHashTable *wired_indices;
+
+  g_slist_free_full (stream->wired_addresses, (GDestroyNotify) nice_address_free);
+  stream->wired_addresses = NULL;
+  if (!interfaces)
+    return addresses;
+
+  wired_indices = g_hash_table_new (g_direct_hash, g_direct_equal);
+  for (CFIndex i = 0; i < CFArrayGetCount (interfaces); ++i) {
+    SCNetworkInterfaceRef iface = (SCNetworkInterfaceRef)
+        CFArrayGetValueAtIndex (interfaces, i);
+    CFStringRef type = SCNetworkInterfaceGetInterfaceType (iface);
+    CFStringRef name = SCNetworkInterfaceGetBSDName (iface);
+    char bsd_name[IF_NAMESIZE];
+    guint index;
+
+    if (!type || !CFEqual (type, kSCNetworkInterfaceTypeEthernet) ||
+        !name || !CFStringGetCString (name, bsd_name, sizeof (bsd_name),
+            kCFStringEncodingUTF8))
+      continue;
+    index = if_nametoindex (bsd_name);
+    if (index)
+      g_hash_table_add (wired_indices, GUINT_TO_POINTER (index));
+  }
+  CFRelease (interfaces);
+
+  /* Use the same address-to-index lookup as the Darwin UDP socket bind. */
+  for (GSList *i = addresses; i; i = i->next) {
+    guint index = nice_interfaces_get_if_index_by_addr (i->data);
+    if (g_hash_table_contains (wired_indices, GUINT_TO_POINTER (index)))
+      stream->wired_addresses = g_slist_prepend (stream->wired_addresses,
+          nice_address_dup (i->data));
+  }
+  g_hash_table_unref (wired_indices);
+
+  /* Trickle the preferred host candidates first, even before the peer has
+   * received the full checklist. The sort is stable within each group. */
+  return stream->wired_addresses ?
+      g_slist_sort_with_data (addresses, wired_first, stream) : addresses;
+}
+
+guint32
+nice_stream_ice_priority (NiceStream *stream, const NiceCandidate *candidate,
+    gboolean reliable, gboolean nat_assisted)
+{
+  guint32 priority = nice_candidate_ice_priority (candidate, reliable, nat_assisted);
+
+  /* RFC local preference bit 9 is unused by libnice. Keep the transport
+   * direction, candidate type and per-address tie breakers intact. */
+  if (is_wired_address (stream, &candidate->base_addr))
+    priority |= 1u << (8 + 9);
+  return priority;
+}
+
 /* Simple tracking for the number of alive streams. These must be accessed
  * atomically. */
 static volatile unsigned int n_streams_created = 0;
@@ -191,6 +269,7 @@ nice_stream_finalize (GObject *obj)
   stream = NICE_STREAM (obj);
 
   g_free (stream->name);
+  g_slist_free_full (stream->wired_addresses, (GDestroyNotify) nice_address_free);
   g_slist_free_full (stream->components, (GDestroyNotify) g_object_unref);
 
   g_atomic_int_inc (&n_streams_destroyed);
