 #ifdef G_OS_UNIX
 
 #include <stdio.h>
@@ -642,6 +651,7 @@ nice_interfaces_get_ip_for_interface (gchar *interface_name)
 
 #include <winsock2.h>
 #include <iphlpapi.h>
+#include <netioapi.h>
 
 // Should be in Iphlpapi.h, but mingw doesn't seem to have these
 // Values copied directly from:
@@ -930,3 +940,108 @@ out:
 #error Can not use this method for retreiving ip list from OS other than unix or windows
 #endif /* G_OS_WIN32 */
 #endif /* G_OS_UNIX */
+
+#ifdef __linux__
+static gboolean
+linux_interface_is_wired (int sock, const char *name)
+{
+  struct ethtool_cmd settings = { .cmd = ETHTOOL_GSET };
+  struct ifreq request = { 0 };
+  gchar path[sizeof ("/sys/class/net/") + IF_NAMESIZE];
+  int dir;
+  gboolean physical;
+
+  g_strlcpy (request.ifr_name, name, sizeof (request.ifr_name));
+  if (ioctl (sock, SIOCGIFHWADDR, &request) < 0 ||
+      request.ifr_hwaddr.sa_family != ARPHRD_ETHER)
+    return FALSE;
+
+  /* Wi-Fi and virtual interfaces can expose an Ethernet link-layer address. */
+  g_snprintf (path, sizeof (path), "/sys/class/net/%s", name);
+  dir = open (path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (dir < 0)
+    return FALSE;
+  physical = faccessat (dir, "device", F_OK, 0) == 0 &&
+      faccessat (dir, "phy80211", F_OK, 0) < 0 && errno == ENOENT &&
+      faccessat (dir, "wireless", F_OK, 0) < 0 && errno == ENOENT;
+  close (dir);
+  if (!physical)
+    return FALSE;
+
+  request.ifr_data = (char *) &settings;
+  if (ioctl (sock, SIOCETHTOOL, &request) < 0)
+    return FALSE;
+
+  switch (settings.port) {
+    case PORT_TP:
+    case PORT_AUI:
+    case PORT_MII:
+    case PORT_FIBRE:
+    case PORT_BNC:
+    case PORT_DA:
+      return TRUE;
+    default:
+      return FALSE;
+  }
+}
+#endif
+
+void
+nice_interfaces_add_wired_indices (GHashTable *indices)
+{
+#ifdef G_OS_WIN32
+  IP_ADAPTER_ADDRESSES *adapters = _nice_get_adapters_addresses ();
+
+  for (IP_ADAPTER_ADDRESSES *a = adapters; a; a = a->Next) {
+    MIB_IF_ROW2 row = { 0 };
+
+    if (a->IfType != IF_TYPE_ETHERNET_CSMACD || a->OperStatus != IfOperStatusUp)
+      continue;
+    row.InterfaceLuid = a->Luid;
+    if (GetIfEntry2 (&row) != NO_ERROR ||
+        !row.InterfaceAndOperStatusFlags.HardwareInterface ||
+        row.PhysicalMediumType != NdisPhysicalMedium802_3)
+      continue;
+
+    if (a->IfIndex)
+      g_hash_table_add (indices, GUINT_TO_POINTER (a->IfIndex));
+    if (a->Ipv6IfIndex)
+      g_hash_table_add (indices, GUINT_TO_POINTER (a->Ipv6IfIndex));
+  }
+  g_free (adapters);
+#elif defined(__APPLE__)
+  CFArrayRef interfaces = SCNetworkInterfaceCopyAll ();
+  if (!interfaces)
+    return;
+  for (CFIndex i = 0; i < CFArrayGetCount (interfaces); ++i) {
+    SCNetworkInterfaceRef iface = (SCNetworkInterfaceRef)
+        CFArrayGetValueAtIndex (interfaces, i);
+    CFStringRef type = SCNetworkInterfaceGetInterfaceType (iface);
+    CFStringRef name = SCNetworkInterfaceGetBSDName (iface);
+    char bsd_name[IF_NAMESIZE];
+    guint index;
+
+    if (!type || !CFEqual (type, kSCNetworkInterfaceTypeEthernet) ||
+        !name || !CFStringGetCString (name, bsd_name, sizeof (bsd_name),
+            kCFStringEncodingUTF8))
+      continue;
+    index = if_nametoindex (bsd_name);
+    if (index)
+      g_hash_table_add (indices, GUINT_TO_POINTER (index));
+  }
+  CFRelease (interfaces);
+#elif defined(__linux__)
+  int sock = socket (AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+  if (sock < 0)
+    return;
+  struct if_nameindex *interfaces = if_nameindex ();
+  if (interfaces) {
+    for (struct if_nameindex *i = interfaces; i->if_index; ++i) {
+      if (linux_interface_is_wired (sock, i->if_name))
+        g_hash_table_add (indices, GUINT_TO_POINTER (i->if_index));
+    }
+    if_freenameindex (interfaces);
+  }
+  close (sock);
+#endif
+}
