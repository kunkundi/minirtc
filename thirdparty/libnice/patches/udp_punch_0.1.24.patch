+/* MiniRTC UDP punch API, LGPL-2.1-or-later.
+ * Call on the agent main context.
+ * The caller must verify DTLS and authorize the exact peer endpoint first.
+ * Handles are agent-local, never file descriptors. No automatic scheduling.
+ */
+#ifndef NICE_PUNCH_H
+#define NICE_PUNCH_H
+#include "agent.h"
+G_BEGIN_DECLS
+#define NICE_PUNCH_V1_ABI 2
+/* Identifies the bounded pool backend required by the v1 protocol. */
+guint nice_agent_punch_get_v1_abi (void);
+guint64 nice_agent_punch_open_v1 (NiceAgent *, guint, guint, guint64 generation,
+    const NiceAddress *base, gboolean extra, NiceAddress *bound);
+gint64 nice_agent_punch_get_deadline (NiceAgent *, guint, guint);
+gint nice_agent_punch_send (NiceAgent *, guint, guint, guint64 generation,
+    guint64 handle, const NiceAddress *to, const guint8 *, gsize);
+gboolean nice_agent_punch_promote (NiceAgent *, guint, guint, guint64 generation,
+    guint64 handle, const NiceAddress *remote);
+/* finish=FALSE stops discovery, preserving checks. TRUE prunes unselected
+ * checks before closing. Selected sockets survive both operations. */
+void nice_agent_punch_stop (NiceAgent *, guint, guint, guint64 generation,
+    gboolean finish);
+/* punch-packet signal: stream, component, generation, handle,
+ * NiceCandidate (addr=raw source, base_addr=actual bound address), GBytes.
+ * Emitted outside the agent lock. Caller must reject stale scope and verify
+ * packet authentication; receiving a packet does NOT validate an ICE pair. */
+G_END_DECLS
+#endif
