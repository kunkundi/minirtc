+/* MiniRTC UDP punch extension, LGPL-2.1-or-later. */
+#include "config.h"
+#include "punch.h"
+#include "punch-priv.h"
+#include "conncheck.h"
+#include "udp-bsd.h"
+
+typedef struct {
+  guint64 id, generation;
+  NiceSocket *socket;
+  NiceAddress base;
+  gboolean extra, promoted, receiving;
+} PunchEndpoint;
+static gint live_sockets;
+
+guint nice_agent_punch_get_v1_abi (void) { return NICE_PUNCH_V1_ABI; }
+
+static gboolean active (NiceAgent *a, NiceComponent *c) {
+  CandidatePair *p = &c->selected_pair;
+  return a->compatibility == NICE_COMPATIBILITY_RFC5245 &&
+      !a->force_relay && !a->reliable && a->use_ice_udp &&
+      a->relay_upgrade_timeout && a->support_renomination &&
+      a->nomination_mode == NICE_NOMINATION_MODE_REGULAR &&
+      c->state == NICE_COMPONENT_STATE_READY &&
+      c->relay_upgrade_deadline > g_get_monotonic_time () &&
+      p->local && p->remote &&
+      (p->local->c.type == NICE_CANDIDATE_TYPE_RELAYED ||
+       p->remote->c.type == NICE_CANDIDATE_TYPE_RELAYED);
+}
+static PunchEndpoint *lookup (NiceComponent *c, guint64 generation, guint64 id) {
+  GSList *i;
+  for (i = c->punch_endpoints; i; i = i->next) {
+    PunchEndpoint *e = i->data;
+    if (e->id == id && e->generation == generation) return e;
+  }
+  return NULL;
+}
+void nice_punch_forget_socket (NiceComponent *c, NiceSocket *s) {
+  GSList *i = c->punch_endpoints;
+  while (i) {
+    GSList *next = i->next;
+    PunchEndpoint *e = i->data;
+    if (e->socket == s) {
+      if (e->extra) g_atomic_int_add (&live_sockets, -1);
+      g_free (e);
+      c->punch_endpoints = g_slist_delete_link (c->punch_endpoints, i);
+    }
+    i = next;
+  }
+}
+void nice_punch_clear (NiceComponent *c) {
+  while (c->punch_endpoints) {
+    PunchEndpoint *e = c->punch_endpoints->data;
+    nice_punch_forget_socket (c, e->socket);
+  }
+}
+void nice_punch_stop_unlocked (NiceAgent *a, NiceComponent *c,
+    guint64 generation, gboolean finish) {
+  GSList *i = c->punch_endpoints;
+  while (i) {
+    GSList *next = i->next;
+    PunchEndpoint *e = i->data;
+    if (!generation || e->generation == generation) {
+      e->receiving = FALSE;
+      if (!e->extra) {
+        nice_punch_forget_socket (c, e->socket);
+      } else if ((!e->promoted || finish) &&
+          (!c->selected_pair.local || c->selected_pair.local->sockptr != e->socket)) {
+        /* Removes transactions/triggered queue before candidates and socket.
+         * The detach hook returns the process quota only at actual close. */
+        nice_component_remove_socket (a, c, e->socket);
+      }
+    }
+    i = next;
+  }
+}
+gint64 nice_agent_punch_get_deadline (NiceAgent *a, guint sid, guint cid) {
+  NiceComponent *c; gint64 result = 0;
+  agent_lock (a);
+  if (agent_find_component (a, sid, cid, NULL, &c) && active (a, c))
+    result = c->relay_upgrade_deadline;
+  agent_unlock_and_emit (a);
+  return result;
+}
+guint64 nice_agent_punch_open_v1 (NiceAgent *a, guint sid, guint cid,
+    guint64 generation, const NiceAddress *base, gboolean extra, NiceAddress *bound) {
+  NiceComponent *c; NiceSocket *s = NULL; GSList *i;
+  PunchEndpoint *e; guint64 result = 0; GError *error = NULL;
+  g_return_val_if_fail (g_main_context_is_owner (a->main_context), 0);
+  if (!generation || !base || !bound || nice_address_ip_version (base) != 4)
+    return 0;
+  agent_lock (a);
+  if (!agent_find_component (a, sid, cid, NULL, &c) || !active (a, c)) goto done;
+  /* Endpoints share a bounded pool,
+   * all in one generation, role and original host base. */
+  if (g_slist_length (c->punch_endpoints) >= (extra ? 128 : 1) ||
+      a->punch_next_id == G_MAXUINT64) goto done;
+  for (i = c->punch_endpoints; i; i = i->next) {
+    PunchEndpoint *existing = i->data;
+    if (existing->generation != generation || existing->extra != extra ||
+        !existing->receiving || !nice_address_equal (&existing->base, base)) goto done;
+  }
+  for (i = c->local_candidates; i; i = i->next) {
+    NiceCandidateImpl *local = i->data;
+    if (local->c.type == NICE_CANDIDATE_TYPE_HOST &&
+        local->c.transport == NICE_CANDIDATE_TRANSPORT_UDP &&
+        local->sockptr->type == NICE_SOCKET_TYPE_UDP_BSD &&
+        nice_address_equal (&local->c.addr, base)) { s = local->sockptr; break; }
+  }
+  if (!s) goto done;
+  if (extra) {
+    gint used; NiceAddress address = *base;
+    do {
+      used = g_atomic_int_get (&live_sockets);
+      if (used >= 256) goto done;
+    } while (!g_atomic_int_compare_and_exchange (&live_sockets, used, used + 1));
+    nice_address_set_port (&address, 0);
+    s = nice_udp_bsd_socket_new (a->main_context, &address, a->recv_tos, &error);
+    if (!s) {
+      g_clear_error (&error); g_atomic_int_add (&live_sockets, -1); goto done;
+    }
+    _priv_set_socket_tos (a, s, agent_find_stream (a, sid)->tos);
+    nice_component_attach_socket (c, s);
+  }
+  e = g_new0 (PunchEndpoint, 1);
+  e->id = ++a->punch_next_id;
+  e->generation = generation; e->socket = s; e->extra = extra; e->base = *base;
+  e->receiving = TRUE;
+  c->punch_endpoints = g_slist_append (c->punch_endpoints, e);
+  *bound = s->addr; result = e->id;
+done:
+  agent_unlock_and_emit (a); return result;
+}
+static gboolean probe_shape (const guint8 *bytes, gsize len) {
+  return bytes && len == 80 && bytes[0] == 0xf3 && bytes[1] == 0x4d &&
+      bytes[2] == 0x50 && bytes[3] == 0x31 && bytes[4] == 1 &&
+      (bytes[5] == 0x20 || bytes[5] == 0x21) && bytes[6] == 0 && bytes[7] == 20;
+}
+gint nice_agent_punch_send (NiceAgent *a, guint sid, guint cid,
+    guint64 generation, guint64 handle, const NiceAddress *to,
+    const guint8 *bytes, gsize len) {
+  NiceComponent *c; PunchEndpoint *e; gint result = -1;
+  g_return_val_if_fail (g_main_context_is_owner (a->main_context), -1);
+  if (!to || nice_address_ip_version (to) != 4 ||
+      !nice_address_get_port (to) || !probe_shape (bytes, len)) return -1;
+  agent_lock (a);
+  if (agent_find_component (a, sid, cid, NULL, &c) && active (a, c) &&
+      (e = lookup (c, generation, handle)) && e->receiving)
+    result = nice_socket_send (e->socket, to, len, (const gchar *) bytes);
+  agent_unlock_and_emit (a); return result;
+}
+gboolean nice_agent_punch_promote (NiceAgent *a, guint sid, guint cid,
+    guint64 generation, guint64 handle, const NiceAddress *remote) {
+  NiceComponent *c; PunchEndpoint *e; GSList *i; NiceCandidate *rc = NULL;
+  NiceCandidateImpl *lc; gboolean result = FALSE;
+  g_return_val_if_fail (g_main_context_is_owner (a->main_context), FALSE);
+  if (!remote) return FALSE;
+  agent_lock (a);
+  if (!agent_find_component (a, sid, cid, NULL, &c) || !active (a, c) ||
+      !(e = lookup (c, generation, handle)) || !e->extra || !e->receiving) goto done;
+  if (e->promoted) { result = TRUE; goto done; }
+  guint promoted = 0;
+  for (i = c->punch_endpoints; i; i = i->next)
+    if (((PunchEndpoint *) i->data)->promoted) ++promoted;
+  if (promoted >= 8) goto done;
+  for (i = c->remote_candidates; i; i = i->next) {
+    NiceCandidate *candidate = i->data;
+    if (candidate->type != NICE_CANDIDATE_TYPE_RELAYED &&
+        candidate->transport == NICE_CANDIDATE_TRANSPORT_UDP &&
+        nice_address_equal (&candidate->addr, remote)) { rc = candidate; break; }
+  }
+  if (!rc) goto done;
+  lc = (NiceCandidateImpl *) nice_candidate_new (NICE_CANDIDATE_TYPE_HOST);
+  lc->c.stream_id = sid; lc->c.component_id = cid;
+  lc->c.transport = NICE_CANDIDATE_TRANSPORT_UDP;
+  lc->c.addr = lc->c.base_addr = e->socket->addr;
+  lc->sockptr = e->socket; lc->punch_internal = TRUE;
+  lc->c.priority = nice_candidate_ice_priority (&lc->c, FALSE, FALSE);
+  /* Internal foundation is unique to this base port, never signalled. */
+  g_snprintf (lc->c.foundation, NICE_CANDIDATE_MAX_FOUNDATION,
+      "punch-%" G_GUINT64_FORMAT, handle);
+  c->local_candidates = g_slist_append (c->local_candidates, lc);
+  if (!conn_check_add_for_candidate_pair (a, sid, c, &lc->c, rc)) {
+    c->local_candidates = g_slist_remove (c->local_candidates, lc);
+    nice_candidate_free (&lc->c); goto done;
+  }
+  e->promoted = TRUE; result = TRUE;
+done:
+  agent_unlock_and_emit (a); return result;
+}
+void nice_agent_punch_stop (NiceAgent *a, guint sid, guint cid,
+    guint64 generation, gboolean finish) {
+  NiceComponent *c;
+  g_return_if_fail (g_main_context_is_owner (a->main_context));
+  if (!generation) return;
+  agent_lock (a);
+  if (agent_find_component (a, sid, cid, NULL, &c))
+    nice_punch_stop_unlocked (a, c, generation, finish);
+  agent_unlock_and_emit (a);
+}
+gboolean nice_punch_recv (NiceAgent *a, NiceComponent *c, NiceSocket *s,
+    const NiceAddress *from, const guint8 *bytes, gsize len) {
+  GSList *i;
+  if (s->type != NICE_SOCKET_TYPE_UDP_BSD) return FALSE;
+  for (i = c->punch_endpoints; i; i = i->next) {
+    PunchEndpoint *e = i->data;
+    if (e->socket != s) continue;
+    if (e->receiving && active (a, c) && probe_shape (bytes, len)) {
+      agent_signal_punch_packet (a, c, e->generation, e->id, from, &s->addr, bytes, len);
+      return TRUE;
+    }
+    /* Before promotion do not accept STUN or deliver application packets. */
+    return e->extra && !e->promoted;
+  }
+  return FALSE;
+}
