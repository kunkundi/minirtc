+void nice_punch_forget_socket (NiceComponent *, NiceSocket *);
+void nice_punch_clear (NiceComponent *);
+void nice_punch_stop_unlocked (NiceAgent *, NiceComponent *, guint64, gboolean);
+gboolean nice_punch_recv (NiceAgent *, NiceComponent *, NiceSocket *,
+    const NiceAddress *, const guint8 *, gsize);
