+typedef enum {
+  READY_STATUS_WAIT_NOMINATION = 1,
+  READY_STATUS_WAIT_CHECKS,
+  READY_STATUS_RELAY_BACKGROUND,
+  READY_STATUS_COMPLETE
+} ReadyStatus;
+
+static void
+priv_append_ready_candidate (GString *text, const gchar *label,
+    const NiceCandidate *candidate)
+{
+  gchar address[NICE_ADDRESS_STRING_LEN];
+
+  if (!candidate) {
+    g_string_append_printf (text, " %s=none", label);
+    return;
+  }
+  nice_address_to_string (&candidate->addr, address);
+  g_string_append_printf (text, " %s=%s/%s/[%s]:%u", label,
+      nice_candidate_type_to_string (candidate->type),
+      nice_candidate_transport_to_string (candidate->transport), address,
+      nice_address_get_port (&candidate->addr));
+}
+
+static void
+priv_report_ready_status (NiceAgent *agent, NiceStream *stream,
+    NiceComponent *component, guint valid, guint nominated, guint pending,
+    ReadyStatus status)
+{
+  static const gchar *names[] = { "", "waiting-nomination", "waiting-checks",
+    "relay-background", "ready" };
+  const gboolean ready = status >= READY_STATUS_RELAY_BACKGROUND;
+  const gint64 now = g_get_monotonic_time ();
+  guint candidates = 0, shown = 0, background_direct = 0;
+  GString *text;
+  GSList *i;
+
+  if (!ready && component->ready_wait_started == 0)
+    component->ready_wait_started = now;
+  /* Waiting snapshots are limited to once per second; always report the
+   * transition that explains why the wait ended. Bound candidate detail too. */
+  if (component->ready_status == (guint) status &&
+      (ready || now - component->ready_status_last_log < G_USEC_PER_SEC))
+    return;
+
+  text = g_string_new (NULL);
+  g_string_append_printf (text,
+      "status=%s wait_ms=%" G_GINT64_FORMAT " valid=%u nominated=%u pending=%u"
+      " selected_priority=%" G_GUINT64_FORMAT, names[status],
+      component->ready_wait_started ?
+          (now - component->ready_wait_started) / 1000 : 0,
+      valid, nominated, pending, component->selected_pair.priority);
+  priv_append_ready_candidate (text, "selected_local",
+      (NiceCandidate *) component->selected_pair.local);
+  priv_append_ready_candidate (text, "selected_remote",
+      (NiceCandidate *) component->selected_pair.remote);
+
+  for (i = stream->conncheck_list; i; i = i->next) {
+    CandidateCheckPair *p = i->data;
+    gboolean triggered, blocker, direct_background;
+    const gchar *role;
+
+    if (p->component_id != component->id)
+      continue;
+    triggered = g_slist_find (agent->triggered_check_queue, p) != NULL;
+    direct_background = priv_relay_upgrade_active (agent, component) &&
+        priv_is_direct_upgrade (component, p);
+    if (direct_background &&
+        (p->state == NICE_CHECK_IN_PROGRESS || triggered))
+      background_direct++;
+    /* Mirror the remaining blockers after priv_prune_pending_checks(). */
+    blocker = !direct_background &&
+        p->priority >= component->selected_pair.priority &&
+        (p->state == NICE_CHECK_IN_PROGRESS || triggered);
+    if (nominated == 0) {
+      if (p->state == NICE_CHECK_FAILED)
+        continue;
+      role = "nomination";
+    } else if (blocker) {
+      role = ready ? "background" : "blocker";
+    } else if (pending == 0 && direct_background &&
+        (p->state == NICE_CHECK_IN_PROGRESS || triggered)) {
+      role = "background-direct";
+    } else {
+      continue;
+    }
+    candidates++;
+    if (shown >= 8)
+      continue;
+    shown++;
+    g_string_append_printf (text,
+        "; %s={state=%s priority=%" G_GUINT64_FORMAT
+        " valid=%d nominated=%d triggered=%d retransmit=%d", role,
+        priv_state_to_string (p->state), p->priority, p->valid, p->nominated,
+        triggered, p->retransmit);
+    priv_append_ready_candidate (text, "local", p->local);
+    priv_append_ready_candidate (text, "remote", p->remote);
+    g_string_append_c (text, '}');
+  }
+  g_string_append_printf (text,
+      "; candidates=%u omitted=%u background_direct=%u",
+      candidates, candidates - shown, background_direct);
+  agent_signal_ice_check_status (agent, stream->id, component->id, text->str);
+  g_string_free (text, TRUE);
+  component->ready_status = status;
+  component->ready_status_last_log = now;
+  if (ready)
+    component->ready_wait_started = 0;
+}
