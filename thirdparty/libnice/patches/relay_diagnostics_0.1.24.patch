+static void priv_append_ready_candidate (GString *, const gchar *, const NiceCandidate *);
+
+typedef enum {
+  UPGRADE_CHECK_VALID,
+  UPGRADE_NOMINATION_QUEUED,
+  UPGRADE_NOMINATION_SENT,
+  UPGRADE_NOMINATION_SEND_FAILED,
+  UPGRADE_NOMINATION_RECEIVED
+} UpgradeEvent;
+
+static void
+priv_report_upgrade_pair (NiceAgent *agent, NiceComponent *component,
+    CandidateCheckPair *pair, UpgradeEvent event)
+{
+  static const gchar *names[] = { "check-valid", "nomination-queued",
+    "nomination-sent", "nomination-send-failed", "nomination-received" };
+  const guint bit = 1u << event;
+  GString *text;
+
+  if ((pair->upgrade_events & bit) ||
+      !priv_relay_upgrade_active (agent, component) ||
+      !priv_is_direct_upgrade (component, pair))
+    return;
+  pair->upgrade_events |= bit;
+  text = g_string_new (NULL);
+  g_string_append_printf (text, "relay-upgrade event=%s ice_role=%s valid=%d"
+      " nominated=%d priority=%" G_GUINT64_FORMAT, names[event],
+      agent->controlling_mode ? "controlling" : "controlled",
+      pair->valid, pair->nominated, pair->priority);
+  priv_append_ready_candidate (text, "local", pair->local);
+  priv_append_ready_candidate (text, "remote", pair->remote);
+  agent_signal_ice_check_status (agent, pair->stream_id, component->id, text->str);
+  g_string_free (text, TRUE);
+}
